# Copy to .env and fill in. .env is git-ignored; never commit secrets.

# Database: SQLite by default. For PostgreSQL (docker compose up -d):
# BORS_DATABASE_URL=postgresql+psycopg://bors:bors@127.0.0.1:5432/bors

# Outbound proxy for Cloudflare/Telegram only (TSETMC/CODAL always connect directly).
# Unset = use HTTPS_PROXY from the environment; set to an empty value (BORS_OUTBOUND_PROXY=) = no proxy.
# BORS_OUTBOUND_PROXY=http://127.0.0.1:2081

# Cloudflare Worker (see worker/README.md)
# BORS_WORKER_URL=https://bors-analyser.<your-subdomain>.workers.dev
# BORS_INGEST_TOKEN=<same value as `wrangler secret put INGEST_TOKEN`>

# Tuning
# BORS_LOG_LEVEL=INFO
# BORS_SNAPSHOT_INTERVAL_MIN=2
# BORS_CODAL_SEARCH_INTERVAL_S=5
# BORS_CODAL_REPORT_INTERVAL_S=1
